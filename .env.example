# Copy to .env for local use. Add secrets only to .env; never commit that file.
# These settings will be read by the configuration layer implemented in P1/P4.

# LLM: extractor and, unless separately configured in YAML, verifier.
LLM_MODEL=openrouter:z-ai/glm-5.3-flash
OPENROUTER_API_KEY=
# OpenRouter-only settings below apply identically to extractor and verifier when using openrouter:.
# LiteLLM and Groq ignore these settings; their requests must not receive them.
OPENROUTER_REASONING=low
# Explicit order takes precedence; latency sort applies only when order is empty.
# Prefer discounted Morph/DeepInfra, then fast standard-price hosts.
# Same-model fallback must respect the per-million-token price ceilings below.
OPENROUTER_PROVIDER_SORT=latency
OPENROUTER_PROVIDER_ORDER=morph,deepinfra,together,baseten,coreweave
# USD per million tokens; forwarded as provider.max_price, not a total-run budget.
OPENROUTER_MAX_PRICE_INPUT=0.15
OPENROUTER_MAX_PRICE_OUTPUT=0.50

# Local biomedical retrieval embeddings. Preserve the model's :latest tag.
EMBEDDINGS_ENABLED=true
EMBEDDING_MODEL=ollama:pankajrajdeo/biomed-embeddings-16l-fp16:latest
# HTTP is Ollama's default local protocol. This value is also the unset default.
# Use the server root, without /api or /v1.
OLLAMA_BASE_URL=http://localhost:11434

# Optional OpenRouter application attribution.
# OPENROUTER_APP_URL=
# OPENROUTER_APP_TITLE=spatial-niche-regulatory-kg

# Alternative LLM providers: configure only when selected in a model selector.
# LITELLM_BASE_URL=
# LITELLM_API_KEY=
# GROQ_API_KEY=

# Sentence Transformers: only needed for gated/private model downloads.
# HF_TOKEN=

# NCBI E-utilities (P3 literature search). The key and contact details are sent only to
# eutils.ncbi.nlm.nih.gov, never to Europe PMC or PubTator. The key raises the NCBI rate
# allowance from 3 to 10 requests/second; it is optional.
NCBI_TOOL=spatial-niche-regulatory-kg
# NCBI_EMAIL=
# NCBI_API_KEY=

# Neo4j: configure in the separate P5 import stage, not for file generation.
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USERNAME=neo4j
# NEO4J_PASSWORD=
# NEO4J_DATABASE=neo4j
